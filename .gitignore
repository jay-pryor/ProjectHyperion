__pycache__/
*.pyc
.DS_Store
# Written by every pytest run and read by check_traces.py for outcomes; never committed.
examples/minimal/trace/results.xml
.pytest_cache/
# mutmut's cache (tooling/mutation_score.py runs it in a scratch copy, but a direct run lands here)
mutants/
# JUnit files from check_null_doubles.py if a run is interrupted before its temp file is removed
*.null-double.xml
# The project console is generated by tooling/build_console.py on every CI run; never committed.
console/
# Per-session scope bindings written by the scope hook (CORE-HRN-001); never committed.
# Depth-independent: examples/minimal is itself a project and a session opened there writes its own.
**/.hyperion/sessions/
# The single-file predecessor of the above; left ignored so an old checkout's copy is not committed.
**/.hyperion/session
**/.hyperion/session-warned
# mypy's incremental cache; check_units.py runs mypy in the project root.
.mypy_cache/
