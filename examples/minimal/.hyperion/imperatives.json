{
  "_comment": "Generated by init_project.py for profiles [simulation] at the framework version in .hyperion/version (CORE-IMP-001). Regenerate with init_project.py --upgrade; never edit or --accept.",
  "imperatives": [
    {
      "id": "IMP-01",
      "text": "Import only from `modules/<name>/contract.*`. Never reach into another module's internals.",
      "source": "CORE-CON-003#the-rule",
      "source_path": "core/contracts/boundary-enforcement.md",
      "section_hash": "47f6f84ab80b2951",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-02",
      "text": "Never make a failing conformance test pass by changing the test. Read the contract and decide which is wrong.",
      "source": "CORE-SES-001#the-load-bearing-prohibitions",
      "source_path": "core/session-protocol.md",
      "section_hash": "ccd398e6d8d57c93",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-03",
      "text": "Never resolve an ambiguity silently. Stop and state both readings.",
      "source": "CORE-SES-001#declaration-stop-and-escalate",
      "source_path": "core/session-protocol.md",
      "section_hash": "1d3696d1f112e7dc",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-05",
      "text": "Put units and reference frames in type names, not comments.",
      "source": "CORE-CON-001#units-and-frames",
      "source_path": "core/contracts/contract-definition.md",
      "section_hash": "7d4204a342f08a6a",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-06",
      "text": "Do not add a dependency without an explicit instruction.",
      "source": "CORE-LFC-004#baseline-definition",
      "source_path": "core/lifecycle/g2-architecture.md",
      "section_hash": "50adbb0efdd8d7da",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-07",
      "text": "Declare session type, scope, and permitted files before touching anything.",
      "source": "CORE-SES-001#declaration-stop-and-escalate",
      "source_path": "core/session-protocol.md",
      "section_hash": "1d3696d1f112e7dc",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-08",
      "text": "Stop if the slice cannot be built within existing contracts.",
      "source": "CORE-SES-001#the-load-bearing-prohibitions",
      "source_path": "core/session-protocol.md",
      "section_hash": "ccd398e6d8d57c93",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-09",
      "text": "Outside a BASELINE session, stop if a change would touch `baseline/`.",
      "source": "CORE-CHG-002#procedure",
      "source_path": "core/change-control/baseline-change-procedure.md",
      "section_hash": "e28e8559ad5a5c81",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-13",
      "text": "Update `trace/` in the same session that changes the thing being traced. Never batch trace updates.",
      "source": "CORE-TRC-001#discipline",
      "source_path": "core/traceability/traceability.md",
      "section_hash": "311989f3b553095f",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-14",
      "text": "Never set `mitigation_status: verified` without a named test that exists and passes.",
      "source": "CORE-TRC-001#results-not-collection",
      "source_path": "core/traceability/traceability.md",
      "section_hash": "bfe9b0c259874186",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-15",
      "text": "Never skip a test or mark one expected-to-fail to get a green run.",
      "source": "CORE-TRC-001#results-not-collection",
      "source_path": "core/traceability/traceability.md",
      "section_hash": "bfe9b0c259874186",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-04",
      "text": "Never loosen a tolerance to get a green run.",
      "source": "SIM-VAL-001#validation-suite",
      "source_path": "profiles/simulation/validation-basis.md",
      "section_hash": "8cba59d11ad81346",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-10",
      "text": "Seed RNG per stochastic stream; iterate in order; no wall-clock time in logic.",
      "source": "SIM-DET-001#what-breaks-it",
      "source_path": "profiles/simulation/determinism.md",
      "section_hash": "f2f49b18de3f3415",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-11",
      "text": "Never silently extrapolate outside a stated validity envelope. Detect and report.",
      "source": "SIM-VAL-001#validity-envelope",
      "source_path": "profiles/simulation/validation-basis.md",
      "section_hash": "d80c35c126a09076",
      "carried_in": "CLAUDE.md"
    },
    {
      "id": "IMP-12",
      "text": "Give every hard-coded tolerance a stated justification naming its basis.",
      "source": "CORE-CON-001#tolerances",
      "source_path": "core/contracts/contract-definition.md",
      "section_hash": "faaa998a4fcbd066",
      "carried_in": "CLAUDE.md"
    }
  ]
}
